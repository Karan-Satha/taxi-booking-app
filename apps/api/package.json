{
  "name": "taxi-booking-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:provision": "tsx src/db/provisionAdmin.ts",
    "test": "npm run build && node --test",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "connect-pg-simple": "10.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.1.0",
    "express-session": "1.18.2",
    "helmet": "8.3.0",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.18.2",
    "@types/node": "26.6.5",
    "@types/pg": "8.15.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
